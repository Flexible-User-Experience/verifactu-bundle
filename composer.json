{
    "name": "flexible-ux/verifactu-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle to deal with Veri*Factu Spanish digital invoicing law and legal QR code generation",
    "keywords": [
        "aeat",
        "qr",
        "sii",
        "symfony",
        "symfony-bundle",
        "verifactu"
    ],
    "homepage": "https://github.com/Flexible-User-Experience/verifactu-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "David Romaní",
            "email": "david@flux.cat",
            "homepage": "https://github.com/davidromani"
        }
    ],
    "autoload": {
        "psr-4": {
            "Flux\\VerifactuBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flux\\VerifactuBundle\\Tests\\": "tests"
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-gd": "*",
        "ext-libxml": "*",
        "endroid/qr-code": "^6.0",
        "josemmo/verifactu-php": "^0.3.4",
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "symfony/config": "^6.4|^7.3|^8.0",
        "symfony/dependency-injection": "^6.4|^7.3|^8.0",
        "symfony/filesystem": "^6.4|^7.3|^8.0",
        "symfony/http-kernel": "^6.4|^7.3|^8.0",
        "symfony/serializer": "^6.4|^7.3|^8.0",
        "symfony/twig-bundle": "^6.4|^7.3|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.1",
        "symfony/phpunit-bridge": "^7.3|^8.0"
    },
    "config": {
        "sort-packages": true
    }
}
